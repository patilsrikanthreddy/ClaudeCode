{
  "compilerOptions": {
    "target": "ES2019",
    "module": "AMD",
    "lib": ["ES2019", "DOM"],
    "outDir": "./src/FileCabinet/SuiteScripts",
    "rootDir": "./src/TypeScripts",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "N/*": ["node_modules/@hitc/netsuite-types/N/*"]
    }
  },
  "include": ["src/TypeScripts/**/*", "node_modules/@hitc/netsuite-types/**/*.d.ts"],
  "exclude": ["node_modules/@hitc/netsuite-types/spec"]
}
